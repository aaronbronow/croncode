FROM python:3.11-alpine

# Alpine images include crond (busybox) by default. 
# No extra package installation needed, maximizing portability.

WORKDIR /app

# Create the script file
RUN cat <<'EOF' > /app/script.py
import urllib.request
import json
import ssl

def get_hackernews_headlines():
    """
    Fetches the latest news headlines from Hacker News and prints them.
    Uses urllib to avoid external dependencies.
    """
    top_stories_url = "https://hacker-news.firebaseio.com/v0/topstories.json"
    item_url_template = "https://hacker-news.firebaseio.com/v0/item/{}.json"
    
    # Create an unverified SSL context if needed, though alpine should have certs
    context = ssl.create_default_context()

    try:
        # Get the IDs of the top stories
        with urllib.request.urlopen(top_stories_url, context=context) as response:
            if response.getcode() != 200:
                print(f"Failed to fetch top story IDs: HTTP {response.getcode()}")
                return
            top_story_ids = json.loads(response.read().decode())

        # Fetch and print headlines for the first 10 stories
        print("Latest Hacker News Headlines:")
        for i, story_id in enumerate(top_story_ids[:10]):
            item_url = item_url_template.format(story_id)
            with urllib.request.urlopen(item_url, context=context) as item_response:
                if item_response.getcode() == 200:
                    item_data = json.loads(item_response.read().decode())
                    if item_data and 'title' in item_data:
                        print(f"- {item_data['title']}")
                    else:
                        print(f"- Could not retrieve title for story ID: {story_id}")
                else:
                    print(f"- Error fetching story ID {story_id}: HTTP {item_response.getcode()}")

    except Exception as e:
        print(f"An error occurred: {e}")

if __name__ == "__main__":
    get_hackernews_headlines()
EOF

# Create the entrypoint script
RUN cat <<'EOF' > /usr/local/bin/run.sh
#!/bin/sh

# Export environment variables for cron
env | grep -v 'HOME' | grep -v 'PWD' | grep -v 'PATH' | grep -v 'SHLVL' > /etc/environment

# If arguments are provided, execute them directly (bypass cron)
if [ $# -gt 0 ]; then
    exec "$@"
fi

# Setup crontab (Alpine Busybox path)
mkdir -p /var/spool/cron/crontabs
echo "*/15 * * * * python3 /app/script.py >> /var/log/cron.log 2>&1" > /var/spool/cron/crontabs/root

# Ensure permissions
chmod 0600 /var/spool/cron/crontabs/root
touch /var/log/cron.log

# Run cron in foreground
echo "Starting cron with schedule: */15 * * * *"
exec crond -f -l 2
EOF

RUN chmod +x /usr/local/bin/run.sh /app/script.py

ENTRYPOINT ["/usr/local/bin/run.sh"]
