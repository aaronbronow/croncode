FROM alpine:3.18

# Alpine images include crond (busybox) by default. 
RUN apk add --no-cache curl jq

WORKDIR /app

# Create the script file
RUN cat <<'EOF' > /app/script.sh
set -euo pipefail

# Define the Hacker News API base URL
HN_API_BASE="https://hacker-news.firebaseio.com/v0"

echo "Fetching latest Hacker News headlines..."

# Get the list of the latest story IDs from the newstories endpoint.
# We'll fetch the first 20 IDs to limit the number of individual API calls
# and parse them with jq. If jq is not available, JSON parsing in pure Bash
# would be excessively complex and brittle, making jq a pragmatic choice
# for robust JSON handling in shell scripts.
LATEST_STORY_IDS=$(curl -s "${HN_API_BASE}/newstories.json" | jq -r '.[0:20][]')

if [ -z "$LATEST_STORY_IDS" ]; then
    echo "Failed to retrieve story IDs or no new stories found."
    exit 1
fi

echo "---"

# Loop through each story ID and fetch its details
for STORY_ID in $LATEST_STORY_IDS; do
    # Fetch individual story details using the item endpoint
    STORY_DETAILS=$(curl -s "${HN_API_BASE}/item/${STORY_ID}.json")

    # Extract the title, URL, and type of the item using jq.
    # The '// empty' part handles cases where a field might be null,
    # ensuring that an empty string is returned instead of 'null'.
    TITLE=$(echo "$STORY_DETAILS" | jq -r '.title // empty')
    URL=$(echo "$STORY_DETAILS" | jq -r '.url // empty')
    TYPE=$(echo "$STORY_DETAILS" | jq -r '.type // empty')

    # Only print items that are of type "story" and actually have a title.
    # Comments, jobs, or other types are ignored as the request is for "news" headlines.
    if [ -n "$TITLE" ] && [ "$TYPE" = "story" ]; then
        if [ -n "$URL" ]; then
            echo "$TITLE ($URL)"
        else
            echo "$TITLE"
        fi
    fi
done

echo "---"
echo "Finished fetching headlines."
EOF

# Create the entrypoint script
RUN cat <<'EOF' > /usr/local/bin/run.sh
#!/bin/sh

# Export environment variables for cron
env | grep -v 'HOME' | grep -v 'PWD' | grep -v 'PATH' | grep -v 'SHLVL' > /etc/environment

# If arguments are provided, execute them directly (bypass cron)
if [ $# -gt 0 ]; then
    exec "$@"
fi

# Setup crontab (Alpine Busybox path)
mkdir -p /var/spool/cron/crontabs
echo "* * * * * sh /app/script.sh >> /var/log/cron.log 2>&1" > /var/spool/cron/crontabs/root

# Ensure permissions
chmod 0600 /var/spool/cron/crontabs/root
touch /var/log/cron.log

# Run cron in foreground
echo "Starting cron with schedule: * * * * *"
exec crond -f -l 2
EOF

RUN chmod +x /usr/local/bin/run.sh /app/script.sh

ENTRYPOINT ["/usr/local/bin/run.sh"]